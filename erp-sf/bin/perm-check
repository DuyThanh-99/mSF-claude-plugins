#!/usr/bin/env bash
# Runs CI's permission-set-check on what this branch ADDS (committed since the merge-base with develop,
# plus uncommitted and untracked files), the same way tiered.pre_merge does with the PR's added files.
#   perm-check [base-ref]     default base: merge-base with origin/develop
set -uo pipefail
export PATH="/usr/bin:/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Run inside erp-salesforce." >&2; exit 2; }
cd "$root"; chk=scripts/permission-set-check/check_permission_sets.py
[ -f "$chk" ] || { echo "No $chk here; is this erp-salesforce?" >&2; exit 2; }
base=${1:-$(git merge-base HEAD origin/develop 2>/dev/null || git merge-base HEAD develop)}
list=$(mktemp); trap 'rm -f "$list"' EXIT
{ git diff --name-only --diff-filter=ACR "$base"; git ls-files --others --exclude-standard; } | grep '^packages/' | sort -u > "$list"
echo "Added files under packages/ since $(git rev-parse --short "$base"): $(grep -c . "$list")"
# System python: Homebrew python builds can lack a working XML parser.
py=/usr/bin/python3; [ -x "$py" ] || py=python3
"$py" "$chk" --changed-files "$list"
