# mlocal config for this machine. Copy to ~/.manabie-local/config.env, chmod 600. Never commit.
# Copy the filled-in values from your other machine; ask the team for the keystore if you have none.
ORG_ALIAS=local_manabie
REPO_ROOT=                # blank = the git repo you run mlocal from
JKS_PATH=                 # absolute path to the staging keystore (.jks)
JKS_PASSWORD=             # keystore password (secret)
CERT_NAME=new_staging_2027
JWT_ISS=
JWT_ORG_ID=
JWT_MANABIE_ID=
ADMIN_URL=
WEBAPI_URL=
STUDENT_GRADE_PID=
