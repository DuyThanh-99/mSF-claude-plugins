{
  "description": "erp-sf guards: ask before writes to shared Salesforce orgs and before git commit/push",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-shared-org.sh\"", "timeout": 10 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-git-commit.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
